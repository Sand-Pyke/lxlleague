generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  CREATED
  LIVE
  FINISHED
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique @db.VarChar(24)
  passwordHash String
  isAdmin      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  profile      PlayerProfile?
  signups      MatchSignup[]
}

model PlayerProfile {
  id       Int    @id @default(autoincrement())
  userId   Int    @unique
  name     String
  gameName String
  position String @default("FILL")
  rank     String @default("UNRANKED")
  wins     Int    @default(0)
  losses   Int    @default(0)
  kda      Float  @default(0)
  mvp      Int    @default(0)
  bio      String @default("")
  avatar   String @default("/assets/avatars/u2.jpg")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id          Int          @id @default(autoincrement())
  name        String
  date        DateTime
  status      MatchStatus  @default(CREATED)
  bo          String       @default("BO3")
  playerCount Int          @default(0)
  teamCount   Int          @default(2)
  blueTeam    String       @default("蓝色方")
  redTeam     String       @default("红色方")
  blueScore   Int          @default(0)
  redScore    Int          @default(0)
  round       String       @default("常规赛")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  signups     MatchSignup[]
}

model MatchSignup {
  id        Int      @id @default(autoincrement())
  userId    Int
  matchId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}
