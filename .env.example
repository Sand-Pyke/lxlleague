# Use a long, unique password before production deployment.
POSTGRES_DB=lxl
POSTGRES_USER=lxl
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
CAPTCHA_SECRET=replace-with-a-long-random-captcha-secret
# 会话 Cookie（登录态）与验证码的签名密钥。留空时会退回 CAPTCHA_SECRET，再退回 ADMIN_PASSWORD。
# 建议单独设置一串 32 位以上的随机字符串；更换它会让所有人（含管理员）需要重新登录。
# 生产环境未单独配置时服务端会打印告警：验证码的签名样本会随 /api/captcha 发给匿名访客，
# 与登录态共用同一把密钥会留下可离线爆破的比对样本。
SESSION_SECRET=replace-with-a-long-random-session-secret
APP_PORT=3000
# 头像、自定义背景等上传文件在宿主机上的存放目录（容器内固定挂在 /app/data/uploads）。
# 换过目录后旧上传文件不会自动搬迁，请先把原目录内容拷过去。
# 配置了下方 OSS 变量后上传会直接写入 OSS，此目录仅作未配置 OSS 时的本地回退。
UPLOAD_DIR=./data/uploads

# 阿里云 OSS 对象存储（可选）：四个必填项全部配置后上传图片直传 OSS，不再落本地磁盘；
# 留空则继续使用上面的 UPLOAD_DIR 本地存储，开发环境无需配置。
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-bucket-name
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# Bucket 开启公网读后配置公网访问地址，/assets/... 会 307 直跳 OSS 省应用带宽（可选）：
# OSS_PUBLIC_BASE_URL=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com
# 对象 Key 前缀，同一 Bucket 分目录用（可选）：
# OSS_PREFIX=lol-champion
COMPOSE_PROJECT_NAME=lol-champion
