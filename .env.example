# Use a long, unique password before production deployment.
POSTGRES_DB=lxl
POSTGRES_USER=lxl
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
CAPTCHA_SECRET=replace-with-a-long-random-captcha-secret
APP_PORT=3000
# 头像、自定义背景等上传文件在宿主机上的存放目录（容器内固定挂在 /app/data/uploads）。
# 换过目录后旧上传文件不会自动搬迁，请先把原目录内容拷过去。
UPLOAD_DIR=./data/uploads
COMPOSE_PROJECT_NAME=lol-champion
